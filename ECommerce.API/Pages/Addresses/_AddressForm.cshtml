@model ECommerce.API.Pages.Addresses.AddressInputModel
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label">@Localizer["Address.FullName"]</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label">@Localizer["Address.Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Street" class="form-label">@Localizer["Address.Street"]</label>
        <input asp-for="Street" class="form-control" />
        <span asp-validation-for="Street" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="City" class="form-label">@Localizer["Address.City"]</label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Governorate" class="form-label">@Localizer["Address.Governorate"]</label>
        <input asp-for="Governorate" class="form-control" />
        <span asp-validation-for="Governorate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PostalCode" class="form-label">@Localizer["Address.PostalCode"] (@Localizer["Common.Optional"])</label>
        <input asp-for="PostalCode" class="form-control" />
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsDefault" class="form-check-input" role="switch" />
            <label asp-for="IsDefault" class="form-check-label">@Localizer["Address.SetDefault"]</label>
        </div>
    </div>
</div>
