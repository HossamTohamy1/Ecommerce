@page
@model ECommerce.API.Pages.Addresses.CreateModel
@{
    ViewData["Title"] = Localizer["Address.Create"].Value;
}

<div class="page-header">
    <h1>@Localizer["Address.Create"]</h1>
    <a class="btn btn-outline-secondary" asp-page="/Addresses/Index"><i class="bi bi-arrow-left me-1"></i>@Localizer["Common.Back"]</a>
</div>

<div class="card">
    <div class="card-body p-4">
        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_AddressForm" for="Input" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">@Localizer["Common.Save"]</button>
                <a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? "/Addresses/Index" : Model.ReturnUrl)" class="btn btn-outline-secondary px-4">@Localizer["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
