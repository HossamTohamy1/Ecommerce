@page
@model ECommerce.API.Pages.Orders.Admin.AllOrdersModel
@{
    ViewData["Title"] = Localizer["Nav.AllOrders"].Value;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">@Localizer["Nav.AllOrders"]</h1>
</div>

@if (Model.Result.Items.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">@Localizer["Common.NoDataFound"]</div>
    </div>
}
else
{
    <!-- 1. DESKTOP / TABLET VIEW (>= 768px) -->
    <div class="card border-0 shadow-sm d-none d-md-block">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted fw-semibold text-uppercase fs-8 border-bottom">
                        <th class="ps-4">@Localizer["Order.OrderNumber"]</th>
                        <th>@Localizer["Common.Date"]</th>
                        <th>@Localizer["Order.Status"]</th>
                        <th>@Localizer["Order.PaymentStatus"]</th>
                        <th>@Localizer["Order.TotalAmount"]</th>
                        <th class="text-end pe-4">@Localizer["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Result.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-page="/Orders/Details" asp-route-id="@order.Id" class="fw-bold text-brand text-decoration-none">
                                    @order.OrderNumber
                                </a>
                            </td>
                            <td class="text-muted fs-8">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><partial name="_OrderStatusBadge" model="order.Status" /></td>
                            <td>
                                <span class="badge badge-light-secondary fs-8">@Localizer["Order.PaymentStatus." + order.PaymentStatus]</span>
                            </td>
                            <td class="fw-bold text-dark">$@order.TotalAmount.ToString("0.00")</td>
                            <td class="text-end pe-4">
                                <a class="btn btn-sm btn-outline-secondary py-1 px-3" asp-page="/Orders/Details" asp-route-id="@order.Id">
                                    @Localizer["Common.ViewDetails"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. MOBILE VIEW (< 768px: Stacked Responsive Cards) -->
    <div class="d-md-none d-flex flex-column gap-3">
        @foreach (var order in Model.Result.Items)
        {
            <div class="card border-0 shadow-sm p-3">
                <!-- Top Row: Order # + Status Badge -->
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <a asp-page="/Orders/Details" asp-route-id="@order.Id" class="fw-bold fs-6 text-brand text-decoration-none text-truncate" title="@order.OrderNumber">
                        @order.OrderNumber
                    </a>
                    <div class="flex-shrink-0">
                        <partial name="_OrderStatusBadge" model="order.Status" />
                    </div>
                </div>

                <!-- Middle Row: Date + Payment Status -->
                <div class="d-flex align-items-center justify-content-between text-muted fs-8 mb-3">
                    <div>
                        <i class="bi bi-clock me-1"></i>
                        <span>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div>
                        <span class="badge badge-light-secondary fs-8">@Localizer["Order.PaymentStatus." + order.PaymentStatus]</span>
                    </div>
                </div>

                <!-- Bottom Row: Total Amount + View Details Button -->
                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                    <div class="d-flex flex-column">
                        <span class="text-muted fs-8 text-uppercase">@Localizer["Order.TotalAmount"]</span>
                        <span class="fw-bold fs-6 text-dark">$@order.TotalAmount.ToString("0.00")</span>
                    </div>
                    <a class="btn btn-sm btn-outline-primary py-1 px-3 d-inline-flex align-items-center gap-1" asp-page="/Orders/Details" asp-route-id="@order.Id">
                        <span>@Localizer["Common.ViewDetails"]</span>
                        <i class="bi bi-chevron-right fs-8"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}

<partial name="_Pagination" model="@(new ECommerce.API.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.Result.Page,
    TotalPages = Model.Result.TotalPages,
    PageName = "/Orders/Admin/AllOrders"
})" />
