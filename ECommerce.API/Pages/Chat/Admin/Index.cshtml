@page
@model ECommerce.API.Pages.Chat.Admin.IndexModel
@{
    ViewData["Title"] = Localizer["Chat.AdminTitle"].Value;
}

<div class="page-header">
    <h1>@Localizer["Chat.AdminTitle"]</h1>
</div>

<div class="card" style="height: 70vh; max-height: 70vh;">
    <div class="row g-0 h-100" style="min-height: 0;">
        <div class="col-12 col-md-4 border-end h-100 d-flex flex-column" id="chatConversationsCol" style="min-height: 0;">
            <div id="conversationsList" class="flex-grow-1 overflow-auto" style="min-height: 0;" data-empty-text="@Localizer["Chat.NoConversations"]" data-initial-id="@Model.ConversationId"></div>
        </div>
        <div class="col-12 col-md-8 h-100 d-none d-md-flex flex-column" id="chatMessagesCol" style="min-height: 0;">
            <div class="d-md-none border-bottom p-2 d-flex align-items-center">
                <button type="button" class="btn btn-sm btn-light d-flex align-items-center gap-1" id="chatBackToList">
                    <i class="bi bi-arrow-left"></i> @Localizer["Common.Back"]
                </button>
            </div>
            <div id="chatMessages" class="flex-grow-1 overflow-auto p-4 d-flex flex-column gap-3" style="min-height: 0;" data-empty-text="@Localizer["Chat.SelectConversation"]"></div>
            <div class="border-top p-3 d-none" id="chatFormWrapper">
                <form id="chatForm" class="d-flex gap-2">
                    <input type="text" id="chatInput" class="form-control" placeholder="@Localizer["Chat.TypeMessage"]" maxlength="2000" autocomplete="off" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>@Localizer["Chat.Send"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat-admin.js" asp-append-version="true" defer></script>
}
