@page
@model ECommerce.API.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["Auth.ForgotPassword.Title"].Value;
    Layout = "_AuthLayout";
}

<h2 class="fw-bold mb-1">@Localizer["Auth.ForgotPassword.Title"]</h2>
<p class="text-muted mb-4">@Localizer["Auth.ForgotPassword.Subtitle"]</p>

@if (Model.EmailSent)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>@Localizer["Auth.ForgotPassword.Subtitle"]
    </div>
    <a asp-page="/Account/ResetPassword" class="btn btn-primary w-100 py-2 fw-semibold">@Localizer["Auth.ResetPassword.Title"]</a>
}
else
{
    <form method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">@Localizer["Auth.Login.Email"]</label>
            <input asp-for="Input.Email" class="form-control form-control-lg form-control-solid" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">@Localizer["Auth.ForgotPassword.SubmitButton"]</button>
    </form>
}

<p class="text-center text-muted mt-4 mb-0">
    <a asp-page="/Account/Login">@Localizer["Common.Back"]</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
