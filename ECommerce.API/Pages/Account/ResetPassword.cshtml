@page
@model ECommerce.API.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = Localizer["Auth.ResetPassword.Title"].Value;
    Layout = "_AuthLayout";
}

<h2 class="fw-bold mb-1">@Localizer["Auth.ResetPassword.Title"]</h2>
<p class="text-muted mb-4">@Localizer["Auth.ForgotPassword.Subtitle"]</p>

<form method="post" novalidate>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">@Localizer["Auth.Login.Email"]</label>
        <input asp-for="Input.Email" class="form-control form-control-lg form-control-solid" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Token" class="form-label">@Localizer["Auth.ResetPassword.Token"]</label>
        <input asp-for="Input.Token" class="form-control form-control-lg form-control-solid" />
        <span asp-validation-for="Input.Token" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">@Localizer["Auth.ResetPassword.NewPassword"]</label>
        <input asp-for="Input.NewPassword" class="form-control form-control-lg form-control-solid" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmNewPassword" class="form-label">@Localizer["Auth.ResetPassword.ConfirmNewPassword"]</label>
        <input asp-for="Input.ConfirmNewPassword" class="form-control form-control-lg form-control-solid" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">@Localizer["Auth.ResetPassword.SubmitButton"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
