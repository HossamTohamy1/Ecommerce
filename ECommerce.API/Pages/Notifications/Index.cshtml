@page
@model ECommerce.API.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = Localizer["Notification.Title"].Value;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1>@Localizer["Notification.Title"]</h1>
    <form method="post" asp-page-handler="MarkAllRead">
        <button type="submit" class="btn btn-sm btn-light-primary">
            <i class="bi bi-check2-all me-1"></i>@Localizer["Notification.MarkAllRead"]
        </button>
    </form>
</div>

<div class="card">
    <div class="list-group list-group-flush notification-list">
        @if (Model.Result.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">@Localizer["Notification.Empty"]</div>
        }
        @foreach (var n in Model.Result.Items)
        {
            <a href="@(string.IsNullOrEmpty(n.Url) ? "#" : n.Url)" class="list-group-item list-group-item-action notification-item d-flex gap-3 align-items-center @(n.IsRead ? "notification-read" : "notification-unread")">
                <div class="notification-icon-wrapper flex-shrink-0">
                    <i class="bi bi-bell fs-3 text-primary"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold notification-title">@n.Title</div>
                    <div class="notification-message fs-7">@n.Message</div>
                    <div class="notification-time fs-8">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                @if (!n.IsRead)
                {
                    <span class="badge badge-circle badge-primary align-self-center flex-shrink-0">&nbsp;</span>
                }
            </a>
        }
    </div>
</div>

<partial name="_Pagination" model="@(new ECommerce.API.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.Result.Page,
    TotalPages = Model.Result.TotalPages,
    PageName = "/Notifications/Index"
})" />
