@page "{id:guid}"
@model ECommerce.API.Pages.Products.Admin.EditModel
@{
    ViewData["Title"] = Localizer["Product.Edit"].Value;
    var currentImage = Model.Product?.Images.FirstOrDefault();
}

<div class="page-header mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <h1>@Localizer["Product.Edit"]</h1>
    <div class="d-flex align-items-center gap-2">
        <form method="post" asp-page-handler="Delete" class="d-inline"
              data-confirm-delete
              data-confirm-title="@Localizer["Common.AreYouSure"]"
              data-confirm-text="@Localizer["Common.ThisActionCannotBeUndone"]"
              data-confirm-button="@Localizer["Common.Delete"]"
              data-cancel-button="@Localizer["Common.Cancel"]">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i>@Localizer["Common.Delete"]
            </button>
        </form>
        <a class="btn btn-outline-secondary" asp-page="/Products/Index">
            <i class="bi bi-arrow-left me-1"></i>@Localizer["Common.Back"]
        </a>
    </div>
</div>

<!-- Section 1: General Details -->
<div class="card mb-4 shadow-sm">
    <div class="card-header fs-5 fw-bold d-flex align-items-center">
        <i class="bi bi-info-circle me-2 text-primary"></i>@Localizer["Product.BasicInformation"]
    </div>
    <div class="card-body p-4">
        <form method="post" asp-page-handler="UpdateDetails" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">@Localizer["Common.Name"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SKU" class="form-label">@Localizer["Product.SKU"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.SKU" class="form-control" />
                    <span asp-validation-for="Input.SKU" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">@Localizer["Common.Description"]</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.Price" class="form-label">@Localizer["Common.Price"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Price" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.CompareAtPrice" class="form-label">@Localizer["Product.CompareAtPrice"] (@Localizer["Common.Optional"])</label>
                    <input asp-for="Input.CompareAtPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.CompareAtPrice" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.StockQuantity" class="form-label">@Localizer["Product.StockQuantity"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.StockQuantity" class="form-control" type="number" />
                    <span asp-validation-for="Input.StockQuantity" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3 d-flex align-items-end">
                    <div class="form-check form-switch py-2">
                        <input asp-for="Input.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="Input.IsActive" class="form-check-label ms-2">@Localizer["Common.Active"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.CategoryId" class="form-label">@Localizer["Product.Category"] <span class="text-danger">*</span></label>
                    <select asp-for="Input.CategoryId" class="form-select">
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.BrandId" class="form-label">@Localizer["Product.Brand"] (@Localizer["Common.Optional"])</label>
                    <select asp-for="Input.BrandId" class="form-select">
                        <option value="">@Localizer["Product.SelectBrand"]</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary px-4 w-100 w-sm-auto">
                    <i class="bi bi-check2 me-1"></i>@Localizer["Common.Save"]
                </button>
                <a asp-page="/Products/Index" class="btn btn-outline-secondary px-4 w-100 w-sm-auto">
                    @Localizer["Common.Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Section 2: Product Image (Single Image Semantics) -->
<div class="card mb-4 shadow-sm">
    <div class="card-header fs-5 fw-bold d-flex align-items-center">
        <i class="bi bi-image me-2 text-primary"></i>@Localizer["Common.Image"]
    </div>
    <div class="card-body p-4">
        @if (currentImage != null)
        {
            <div class="mb-4">
                <div class="card p-2 text-center shadow-xs border d-inline-block image-preview-card" style="max-width: 220px;">
                    <img src="@currentImage.ImageUrl" class="rounded mb-2" style="width: 200px; height: 180px; object-fit: cover;" alt="@Model.Product?.Name" />
                    <div class="d-flex justify-content-center">
                        <form method="post" asp-page-handler="DeleteImage" asp-route-imageId="@currentImage.Id"
                              data-confirm-delete
                              data-confirm-title="@Localizer["Common.AreYouSure"]"
                              data-confirm-button="@Localizer["Common.Delete"]"
                              data-cancel-button="@Localizer["Common.Cancel"]">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["Common.Delete"]">
                                <i class="bi bi-trash me-1"></i>@Localizer["Common.Delete"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light border text-muted d-flex align-items-center gap-2 mb-4 image-empty-state">
                <i class="bi bi-image fs-4"></i>
                <span>@Localizer["Common.NoDataFound"]</span>
            </div>
        }

        <form method="post" asp-page-handler="UploadImage" enctype="multipart/form-data" class="d-flex flex-wrap align-items-center gap-2">
            <div class="flex-grow-1" style="max-width: 400px;">
                <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" />
            </div>
            <button type="submit" class="btn btn-light-primary">
                <i class="bi bi-cloud-arrow-up me-1"></i>@Localizer["Product.UploadImage"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
