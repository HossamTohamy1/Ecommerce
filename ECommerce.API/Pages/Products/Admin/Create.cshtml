@page
@model ECommerce.API.Pages.Products.Admin.CreateModel
@{
    ViewData["Title"] = Localizer["Product.Create"].Value;
}

<div class="page-header">
    <h1>@Localizer["Product.Create"]</h1>
    <a class="btn btn-outline-secondary" asp-page="/Products/Index"><i class="bi bi-arrow-left me-1"></i>@Localizer["Common.Back"]</a>
</div>

<div class="card shadow-sm">
    <div class="card-header fs-5 fw-bold">
        <i class="bi bi-info-circle me-2 text-primary"></i>@Localizer["Product.BasicInformation"]
    </div>
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">@Localizer["Common.Name"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SKU" class="form-label">@Localizer["Product.SKU"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.SKU" class="form-control" />
                    <span asp-validation-for="Input.SKU" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label">@Localizer["Common.Description"]</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.Price" class="form-label">@Localizer["Common.Price"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Price" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.CompareAtPrice" class="form-label">@Localizer["Product.CompareAtPrice"] (@Localizer["Common.Optional"])</label>
                    <input asp-for="Input.CompareAtPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.CompareAtPrice" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.StockQuantity" class="form-label">@Localizer["Product.StockQuantity"] <span class="text-danger">*</span></label>
                    <input asp-for="Input.StockQuantity" class="form-control" type="number" />
                    <span asp-validation-for="Input.StockQuantity" class="text-danger small"></span>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label asp-for="Input.CategoryId" class="form-label">@Localizer["Product.Category"] <span class="text-danger">*</span></label>
                    <select asp-for="Input.CategoryId" class="form-select">
                        <option value="" disabled selected>@Localizer["Product.SelectCategory"]</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.BrandId" class="form-label">@Localizer["Product.Brand"] (@Localizer["Common.Optional"])</label>
                    <select asp-for="Input.BrandId" class="form-select">
                        <option value="">@Localizer["Product.SelectBrand"]</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.Image" class="form-label">@Localizer["Common.Image"] (@Localizer["Common.Optional"])</label>
                    <input asp-for="Input.Image" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" />
                </div>
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary px-4 w-100 w-sm-auto">@Localizer["Common.Save"]</button>
                <a asp-page="/Products/Index" class="btn btn-outline-secondary px-4 w-100 w-sm-auto">@Localizer["Common.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
