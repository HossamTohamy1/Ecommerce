@page
@model ECommerce.API.Pages.Categories.IndexModel
@using ECommerce.Shared.Constants
@{
    ViewData["Title"] = Localizer["Category.Title"].Value;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 fw-bold mb-0">@Localizer["Category.Title"]</h1>
    @if (User.IsInRole(AppConstants.Roles.Admin))
    {
        <a class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" asp-page="/Categories/Admin/Create">
            <i class="bi bi-plus-lg"></i>
            <span>@Localizer["Category.Create"]</span>
        </a>
    }
</div>

@if (Model.Result.Items.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">@Localizer["Common.NoDataFound"]</div>
    </div>
}
else
{
    <!-- 1. DESKTOP / TABLET VIEW (>= 768px) -->
    <div class="card border-0 shadow-sm d-none d-md-block">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted fw-semibold text-uppercase fs-8 border-bottom">
                        <th class="ps-4">@Localizer["Common.Name"]</th>
                        <th>@Localizer["Category.Slug"]</th>
                        <th>@Localizer["Category.ParentCategory"]</th>
                        <th class="text-center">@Localizer["Category.ProductCount"]</th>
                        @if (User.IsInRole(AppConstants.Roles.Admin))
                        {
                            <th class="text-end pe-4">@Localizer["Common.Actions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Result.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@category.Name</td>
                            <td><code class="text-muted">@category.Slug</code></td>
                            <td>@(category.ParentCategoryName ?? "—")</td>
                            <td class="text-center"><span class="badge badge-light-info">@category.ProductCount</span></td>
                            @if (User.IsInRole(AppConstants.Roles.Admin))
                            {
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-icon btn-active-light-primary" asp-page="/Categories/Admin/Edit" asp-route-id="@category.Id" title="@Localizer["Common.Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="d-inline"
                                          data-confirm-delete
                                          data-confirm-title="@Localizer["Common.AreYouSure"]"
                                          data-confirm-text="@Localizer["Common.ThisActionCannotBeUndone"]"
                                          data-confirm-button="@Localizer["Common.Delete"]"
                                          data-cancel-button="@Localizer["Common.Cancel"]">
                                        <button type="submit" class="btn btn-sm btn-icon text-danger" title="@Localizer["Common.Delete"]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. MOBILE VIEW (< 768px: Stacked Responsive Cards) -->
    <div class="d-md-none d-flex flex-column gap-3">
        @foreach (var category in Model.Result.Items)
        {
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                    <div class="min-w-0 flex-grow-1 pe-2">
                        <div class="fw-bold fs-6 text-dark text-truncate" title="@category.Name">@category.Name</div>
                        <div class="text-muted fs-8 mt-1">
                            <code class="text-muted">@category.Slug</code>
                        </div>
                    </div>
                    @if (User.IsInRole(AppConstants.Roles.Admin))
                    {
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <a class="btn btn-sm btn-icon btn-light-primary" asp-page="/Categories/Admin/Edit" asp-route-id="@category.Id" title="@Localizer["Common.Edit"]">
                                <i class="bi bi-pencil fs-6"></i>
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="d-inline"
                                  data-confirm-delete
                                  data-confirm-title="@Localizer["Common.AreYouSure"]"
                                  data-confirm-text="@Localizer["Common.ThisActionCannotBeUndone"]"
                                  data-confirm-button="@Localizer["Common.Delete"]"
                                  data-cancel-button="@Localizer["Common.Cancel"]">
                                <button type="submit" class="btn btn-sm btn-icon text-danger" title="@Localizer["Common.Delete"]">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top fs-8 text-muted">
                    <div>
                        <span class="text-muted">@Localizer["Category.ParentCategory"]:</span>
                        <span class="fw-semibold text-dark">@(category.ParentCategoryName ?? "—")</span>
                    </div>
                    <div>
                        <span class="badge badge-light-info">@category.ProductCount @Localizer["Nav.Products"]</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<partial name="_Pagination" model="@(new ECommerce.API.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.Result.Page,
    TotalPages = Model.Result.TotalPages,
    PageName = "/Categories/Index"
})" />
