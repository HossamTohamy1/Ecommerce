@page
@model ECommerce.API.Pages.Wishlist.IndexModel
@{
    ViewData["Title"] = Localizer["Wishlist.Title"].Value;
}

<div class="page-header">
    <h1>@Localizer["Wishlist.Title"]</h1>
</div>

@if (Model.Wishlist.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-heart fs-1 d-block mb-3"></i>
            @Localizer["Wishlist.EmptyList"]
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Wishlist.Items)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100">
                    <a asp-page="/Products/Details" asp-route-id="@item.ProductId">
                        @if (item.ImageUrl is not null)
                        {
                            <img src="@item.ImageUrl" class="product-card-img" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="product-card-img d-flex align-items-center justify-content-center">
                                <i class="bi bi-image fs-1 text-muted"></i>
                            </div>
                        }
                    </a>
                    <div class="card-body">
                        <h6 class="fw-bold">
                            <a asp-page="/Products/Details" asp-route-id="@item.ProductId" class="text-reset text-decoration-none">@item.ProductName</a>
                        </h6>
                        <span class="fw-bold text-brand">@item.Price.ToString("0.00")</span>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <form method="post" asp-page-handler="AddToCart" asp-route-productId="@item.ProductId" class="flex-grow-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-cart-plus"></i></button>
                        </form>
                        <form method="post" asp-page-handler="Remove" asp-route-productId="@item.ProductId">
                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
