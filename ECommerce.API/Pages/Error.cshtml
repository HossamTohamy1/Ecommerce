@page
@model ECommerce.API.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
    <h2 class="fw-bold mt-3">@Localizer["Common.UnexpectedError"]</h2>
    <p class="text-muted">@Model.RequestId</p>
    <a asp-page="/Index" class="btn btn-primary mt-3">@Localizer["Nav.Dashboard"]</a>
</div>
