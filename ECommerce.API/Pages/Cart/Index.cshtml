@page
@model ECommerce.API.Pages.Cart.IndexModel
@{
    ViewData["Title"] = Localizer["Cart.Title"].Value;
}

<div class="page-header">
    <h1>@Localizer["Cart.Title"]</h1>
    <a class="btn btn-outline-secondary" asp-page="/Products/Index"><i class="bi bi-arrow-left me-1"></i>@Localizer["Cart.ContinueShopping"]</a>
</div>

@if (Model.Cart.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-cart-x fs-1 d-block mb-3"></i>
            @Localizer["Cart.Empty"]
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["Product.Title"]</th>
                                <th>@Localizer["Common.Price"]</th>
                                <th>@Localizer["Common.Quantity"]</th>
                                <th>@Localizer["Common.Total"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cart.Items)
                            {
                                <tr>
                                    <td class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="product-thumb" alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <div class="product-thumb d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image fs-4 text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold">@item.ProductName</div>
                                            @if (item.VariantLabel is not null)
                                            {
                                                <small class="text-muted">@item.VariantLabel</small>
                                            }
                                        </div>
                                    </td>
                                    <td>@item.UnitPrice.ToString("0.00")</td>
                                    <td style="width:140px">
                                        <form method="post" asp-page-handler="Update" asp-route-itemId="@item.Id">
                                            <div class="input-group input-group-sm" style="width: 115px;">
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="1000" class="form-control text-center" />
                                                <button type="submit" class="btn btn-light-primary" title="@Localizer["Common.Save"]"><i class="bi bi-arrow-repeat"></i></button>
                                            </div>
                                        </form>
                                    </td>
                                    <td class="fw-semibold">@item.LineTotal.ToString("0.00")</td>
                                    <td>
                                        <form method="post" asp-page-handler="Remove" asp-route-itemId="@item.Id">
                                            <button type="submit" class="btn btn-sm btn-icon text-danger" title="@Localizer["Common.Delete"]"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <form method="post" asp-page-handler="Clear" class="mt-3">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>@Localizer["Common.Delete"] @Localizer["Cart.Title"]</button>
            </form>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header fs-5 fw-bold">
                    <i class="bi bi-receipt me-2 text-primary"></i>@Localizer["Cart.OrderSummary"]
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@Localizer["Order.SubTotal"]</span>
                        <span class="fw-semibold">@Model.Cart.Total.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">@Localizer["Order.ShippingFee"]</span>
                        <span class="text-success fw-semibold">@Localizer["Order.ShippingFree"]</span>
                    </div>
                    <div class="separator my-3"></div>
                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <span class="fw-bold fs-5">@Localizer["Common.Total"]</span>
                        <span class="fw-bold fs-3 text-brand">@Model.Cart.Total.ToString("0.00")</span>
                    </div>
                    @if (Model.HasAddresses)
                    {
                        <a asp-page="/Orders/Checkout" class="btn btn-primary w-100 py-3 fw-bold"><i class="bi bi-credit-card me-2"></i>@Localizer["Cart.Checkout"]</a>
                    }
                    else
                    {
                        <a asp-page="/Addresses/Create" asp-route-returnUrl="/Cart/Index" class="btn btn-primary w-100 py-3 fw-bold"><i class="bi bi-geo-alt me-2"></i>@Localizer["Address.Create"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
}
